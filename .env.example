# OpenAI-compatible endpoint. For Alibaba Cloud Model Studio/DashScope, use your workspace endpoint when available.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=

# Models. These defaults match the current Wulingyuan flow closely while using a current Qwen-VL model.
CHAT_MODEL=qwen3.7-plus
FAST_MODEL=qwen3.6-flash
VISION_MODEL=qwen3-vl-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
ENABLE_WEB_SEARCH=true

# Dify knowledge migration. This self-hosted instance uses the Console API with browser cookies.
DIFY_BASE_URL=https://glassesai.0744trip.com/
DIFY_AUTH_MODE=cookie
# Copy the full Cookie request header value from a logged-in Dify /console/api request.
# It must include csrf_token; the importer extracts it automatically and sends X-CSRF-Token.
# Never commit the real cookie.
DIFY_COOKIE=
# Optional fallback: set DIFY_AUTH_MODE=api_key to use the Knowledge Service API /v1 instead.
DIFY_DATASET_API_KEY=
DIFY_DATASET_ID=
DIFY_REQUEST_TIMEOUT_SECONDS=30

# Local persistence
QDRANT_PATH=.data/qdrant
QDRANT_COLLECTION=wulingyuan_knowledge
HISTORY_PATH=.data/conversations.json

# Retrieval settings. The original Dify workflow used top_k=10, threshold=0.05, vector=0.6, keyword=0.4.
RETRIEVAL_TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=0.05
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
