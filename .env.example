# OpenAI-compatible endpoint. For Alibaba Cloud Model Studio/DashScope, use your workspace endpoint when available.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=

# Models. These defaults match the current Wulingyuan flow closely while using a current Qwen-VL model.
CHAT_MODEL=qwen3.7-plus
FAST_MODEL=qwen3.6-flash
VISION_MODEL=qwen3-vl-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
ENABLE_WEB_SEARCH=true

# Local persistence
QDRANT_PATH=.data/qdrant
QDRANT_COLLECTION=wulingyuan_knowledge
HISTORY_PATH=.data/conversations.json

# Retrieval settings. The original Dify workflow used top_k=10, threshold=0.05, vector=0.6, keyword=0.4.
RETRIEVAL_TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=0.05
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
